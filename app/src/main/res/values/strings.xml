    <!-- Guide -->
    <string name="guide_title">Setup guide</string>
    <string name="guide_step">Step %1$d of %2$d</string>
    <string name="guide1_title">How TapFlow works</string>
    <string name="guide1_body">TapFlow shows a small floating panel over other apps. Place numbered markers where you want taps or swipes, set the interval, then press Start. Markers become see-through and ignore touches while running.</string>
    <string name="guide2_title">Allow restricted settings</string>
    <string name="guide2_body">If you installed TapFlow from a file instead of a store, Android 13 and newer blocks accessibility access until you allow it. Open App info, tap the ⋮ menu in the corner, choose “Allow restricted settings” and confirm.</string>
    <string name="guide3_title">Turn on the service</string>
    <string name="guide3_body">Open Accessibility settings, choose TapFlow under installed apps and switch it on. TapFlow only performs gestures; it never reads your screen.</string>
    <string name="guide4_title">Stay in control</string>
    <string name="guide4_body">Press Stop on the panel, press Volume Down, or use the notification button at any time. Runs also stop when the screen turns off. Use the Test pad to try settings safely.</string>
